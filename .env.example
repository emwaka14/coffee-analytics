# Copy this file to .env and fill in your own values. Never commit .env.

# USDA FAS Open Data — free key from https://api.data.gov/signup/
USDA_API_KEY=

# Optional, for later projects (e.g. price volatility tracker)
FRED_API_KEY=
COMTRADE_API_KEY=

# Postgres (defaults assume a local instance)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffee_analytics
DB_USER=postgres
DB_PASSWORD=
